# Frontend (NEXT_PUBLIC_* values are embedded at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Express API and database
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=
JWT_SECRET=

# Cloudflare R2 object storage (required by server/lib/r2.ts)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OpenAI (required by the current AI service module)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Marketplace safety
# Enable only in isolated non-production TEST/development environments.
ENABLE_TEST_PAYMENT_SIMULATION=false
# Production must point to the email of a deliberately provisioned system seller User.
# Leave blank outside Production to use the existing TEST-only fallback identity.
MARKETPLACE_SYSTEM_SELLER_EMAIL=
