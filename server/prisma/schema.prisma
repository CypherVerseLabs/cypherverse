generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// ENUMS
// =========================================================

enum ProjectTemplate {
  editor
  found
}

enum ParcelStatus {
  available
  owned
  reserved
  for_sale
}

// =========================================================
// CYPH TRANSACTION TYPE
// =========================================================

enum CyphTransactionType {
  ISSUANCE
  TRANSFER
  BURN
  MARKETPLACE_PAYMENT
  MARKETPLACE_REFUND
  ADMIN_ADJUSTMENT
}

// =========================================================
// CYPH TRANSACTION STATUS
// =========================================================

enum CyphTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

// =========================================================
// CYPH ISSUANCE REASON
// =========================================================

enum CyphIssuanceReason {
  STRIPE_PURCHASE
  PROMOTIONAL
  REWARD
  ADMIN_GRANT
  GENESIS
}

enum CyphBurnReason {
  ADMIN_BURN
  SYSTEM
}

// =========================================================
// PARCEL TYPE
// =========================================================

enum ParcelType {
  STANDARD
  CITY_LANDMARK
}

// =========================================================
// MARKETPLACE ORDER STATUS
// =========================================================

enum MarketplaceOrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  GRANTED
  CANCELLED
  FAILED
}

// =========================================================
// MARKETPLACE PAYMENT STATUS
// =========================================================

enum MarketplacePaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// =========================================================
// MARKETPLACE PAYMENT ENVIRONMENT
// =========================================================

enum MarketplaceCurrency {
  USD
  ETH
  CYPH
}

enum MarketplacePaymentMethod {
  USD_PROVIDER
  ETH_BLOCKCHAIN
  CYPH_LEDGER
}

enum MarketplacePaymentEnvironment {
  LOCAL
  STAGING
  PRODUCTION
}

// =========================================================
// MARKETPLACE ENTITLEMENT STATUS
// =========================================================

enum MarketplaceEntitlementStatus {
  GRANTED
}

// =========================================================
// USER
// =========================================================

model User {
  id           String  @id @default(uuid())
  address      String? @unique
  email        String? @unique
  passwordHash String?
  username     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  // -------------------------------------------------------
  // Parcel marketplace
  // -------------------------------------------------------

  parcelsOwned       Parcel[]
  parcelListings     ParcelListing[]
  parcelReservations ParcelReservation[]

  // -------------------------------------------------------
  // Marketplace purchases
  // -------------------------------------------------------

  marketplaceOrders MarketplaceOrder[] @relation("BuyerOrders")

  marketplaceSales MarketplaceOrder[] @relation("SellerOrders")

  marketplacePayments MarketplacePayment[]

  marketplaceEntitlements MarketplaceEntitlement[]

  marketplaceIdempotencyKeys MarketplaceIdempotencyKey[]

  marketplacePaymentEvents MarketplacePaymentEvent[]

  // -------------------------------------------------------
  // CYPH
  // -------------------------------------------------------

  cyphWallet CyphWallet?

  // -------------------------------------------------------
  // Parcel ownership history
  // -------------------------------------------------------

  previousParcelOwnerships ParcelOwnershipHistory[] @relation("PreviousParcelOwner")
  newParcelOwnerships      ParcelOwnershipHistory[] @relation("NewParcelOwner")
}

// =========================================================
// PROJECT
// =========================================================

model Project {
  id          String
  ownerId     String
  name        String
  description String?

  template ProjectTemplate @default(editor)

  scene Json?

  slug        String?   @unique
  publishedAt DateTime?

  parcelId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  assets ProjectAsset[]

  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@id([id])
  @@index([ownerId])
  @@index([publishedAt])
}

// =========================================================
// PROJECT ASSETS
// =========================================================

model ProjectAsset {
  id String @id @default(uuid())

  projectId String

  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, storageKey])
  @@index([projectId])
}

// =========================================================
// PARCEL
// =========================================================

model Parcel {
  id String @id @default(uuid())

  // -------------------------------------------------------
  // Static world identity
  // -------------------------------------------------------

  estateId String @unique

  x Int
  y Int

  // -------------------------------------------------------
  // Permanent parcel classification
  // -------------------------------------------------------

  type ParcelType @default(STANDARD)

  // -------------------------------------------------------
  // Dynamic marketplace state
  // -------------------------------------------------------

  status ParcelStatus @default(available)

  ownerId String?

  price Decimal? @db.Decimal(12, 2)

  // -------------------------------------------------------
  // Optional display information
  // -------------------------------------------------------

  name        String?
  description String?

  // -------------------------------------------------------
  // Optional blockchain identity
  // -------------------------------------------------------

  blockchainAddress String?
  tokenId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------------------------------------
  // Relations
  // -------------------------------------------------------

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  listings ParcelListing[]

  reservations ParcelReservation[]

  project Project?

  // -------------------------------------------------------
  // Marketplace purchase relations
  // -------------------------------------------------------

  marketplaceOrders MarketplaceOrder[]

  marketplaceEntitlements MarketplaceEntitlement[]

  // -------------------------------------------------------
  // Immutable ownership history
  // -------------------------------------------------------

  ownershipHistory ParcelOwnershipHistory[]

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([x, y])
}

// =========================================================
// PARCEL OWNERSHIP HISTORY
// =========================================================

model ParcelOwnershipHistory {
  id String @id @default(uuid())

  parcelId String

  previousOwnerId String?

  newOwnerId String?

  transferredAt DateTime @default(now())

  source String?

  marketplaceOrderId String?

  createdAt DateTime @default(now())

  // -------------------------------------------------------
  // Relations
  // -------------------------------------------------------

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  previousOwner User? @relation("PreviousParcelOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)

  newOwner User? @relation("NewParcelOwner", fields: [newOwnerId], references: [id], onDelete: SetNull)

  marketplaceOrder MarketplaceOrder? @relation(fields: [marketplaceOrderId], references: [id], onDelete: SetNull)

  @@index([parcelId, transferredAt])
  @@index([previousOwnerId])
  @@index([newOwnerId])
  @@index([marketplaceOrderId])
}

// =========================================================
// PARCEL LISTING
// =========================================================

model ParcelListing {
  id String @id @default(uuid())

  parcelId String
  sellerId String

  price    Decimal             @db.Decimal(36, 18)
  currency MarketplaceCurrency @default(USD)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  marketplaceOrders MarketplaceOrder[]

  @@index([parcelId])
  @@index([sellerId])
  @@index([active])
}

// =========================================================
// PARCEL RESERVATION
// =========================================================

model ParcelReservation {
  id String @id @default(uuid())

  parcelId String
  userId   String

  expiresAt DateTime

  createdAt DateTime @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([userId])
  @@index([expiresAt])
}

// =========================================================
// MARKETPLACE ORDER
// =========================================================

model MarketplaceOrder {
  id String @id @default(uuid())

  userId String

  productId String

  listingId String?

  sellerId String

  quantity Int @default(1)

  amount Decimal @db.Decimal(36, 18)

  currency MarketplaceCurrency @default(USD)

  status MarketplaceOrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)

  product Parcel @relation(fields: [productId], references: [id], onDelete: Restrict)

  listing ParcelListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  seller User @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)

  payments MarketplacePayment[]

  entitlements MarketplaceEntitlement[]

  paymentEvents MarketplacePaymentEvent[]

  idempotencyKeys MarketplaceIdempotencyKey[]

  cyphPayment MarketplaceCYPHPayment?

  ownershipHistory ParcelOwnershipHistory[]

  @@index([userId])
  @@index([productId])
  @@index([listingId])
  @@index([sellerId])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
}

// =========================================================
// MARKETPLACE PAYMENT
// =========================================================

model MarketplacePayment {
  id String @id @default(uuid())

  orderId String

  userId String

  externalTransactionId String? @unique

  method MarketplacePaymentMethod

  amount   Decimal             @db.Decimal(36, 18)
  currency MarketplaceCurrency

  network  String?
  metadata Json?

  status MarketplacePaymentStatus @default(PENDING)

  environment MarketplacePaymentEnvironment @default(LOCAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmedAt DateTime?

  failedAt DateTime?

  cancelledAt DateTime?

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  events MarketplacePaymentEvent[] @relation("PaymentEvents")

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([environment])
}

// =========================================================
// MARKETPLACE CYPH PAYMENT
// =========================================================

model MarketplaceCYPHPayment {
  id String @id @default(uuid())

  orderId String

  walletId String

  transactionId String @unique

  amount Decimal @db.Decimal(36, 18)

  createdAt DateTime @default(now())

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  wallet CyphWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  transaction CyphTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([walletId])
  @@index([createdAt])
}

// =========================================================
// MARKETPLACE PAYMENT EVENT
// =========================================================

model MarketplacePaymentEvent {
  id String @id @default(uuid())

  externalEventId String @unique

  externalTransactionId String?

  orderId String

  userId String

  status MarketplacePaymentStatus

  environment MarketplacePaymentEnvironment @default(LOCAL)

  processed Boolean @default(false)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  payment MarketplacePayment? @relation("PaymentEvents", fields: [externalTransactionId], references: [externalTransactionId], onDelete: SetNull)

  @@index([externalTransactionId])
  @@index([orderId])
  @@index([userId])
  @@index([processed])
  @@index([createdAt])
}

// =========================================================
// MARKETPLACE ENTITLEMENT
// =========================================================

model MarketplaceEntitlement {
  id String @id @default(uuid())

  userId String

  productId String

  orderId String

  quantity Int @default(1)

  status MarketplaceEntitlementStatus @default(GRANTED)

  grantedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  product Parcel @relation(fields: [productId], references: [id], onDelete: Restrict)

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
}

// =========================================================
// MARKETPLACE IDEMPOTENCY KEY
// =========================================================

model MarketplaceIdempotencyKey {
  id String @id @default(uuid())

  userId String

  operation String

  key String

  orderId String?

  responseStatus Int?

  responseJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  order MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, operation, key])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

// =========================================================
// CYPH SUPPLY
// =========================================================

model CyphSupply {
  id String @id @default("global")

  totalIssued Decimal @default(0) @db.Decimal(36, 18)

  totalBurned Decimal @default(0) @db.Decimal(36, 18)

  circulatingSupply Decimal @default(0) @db.Decimal(36, 18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// CYPH WALLET
// =========================================================

model CyphWallet {
  id String @id @default(uuid())

  userId String @unique

  balance Decimal @default(0) @db.Decimal(36, 18)

  blockchainAddress String? @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionsFrom CyphTransaction[] @relation("CyphTransactionFromWallet")

  transactionsTo CyphTransaction[] @relation("CyphTransactionToWallet")

  transfersFrom CyphTransfer[] @relation("CyphTransferFromWallet")

  transfersTo CyphTransfer[] @relation("CyphTransferToWallet")

  issuances CyphIssuance[]

  marketplacePayments MarketplaceCYPHPayment[]

  burns CyphBurn[]

  @@index([active])
}

// =========================================================
// CYPH TRANSACTION
// =========================================================

model CyphTransaction {
  id String @id @default(uuid())

  transactionId String @unique @default(uuid())

  blockchainTxHash String? @unique

  fromWalletId String?
  toWalletId   String?

  amount Decimal @db.Decimal(36, 18)

  type CyphTransactionType

  status CyphTransactionStatus @default(CONFIRMED)

  referenceType String?
  referenceId   String?

  idempotencyKey String? @unique

  metadata Json?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  fromWallet CyphWallet? @relation("CyphTransactionFromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)

  toWallet CyphWallet? @relation("CyphTransactionToWallet", fields: [toWalletId], references: [id], onDelete: Restrict)

  issuance CyphIssuance?

  transfer CyphTransfer?

  marketplacePayment MarketplaceCYPHPayment?

  burn CyphBurn?

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// =========================================================
// CYPH ISSUANCE
// =========================================================

model CyphIssuance {
  id String @id @default(uuid())

  walletId String

  transactionId String @unique

  amount Decimal @db.Decimal(36, 18)

  reason CyphIssuanceReason

  externalReferenceId String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  wallet CyphWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  transaction CyphTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([reason])
  @@index([createdAt])
}

// =========================================================
// CYPH BURN
// =========================================================

model CyphBurn {
  id String @id @default(uuid())

  walletId String

  transactionId String @unique

  amount Decimal @db.Decimal(36, 18)

  reason CyphBurnReason

  externalReferenceId String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  wallet CyphWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  transaction CyphTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([reason])
  @@index([createdAt])
}

// =========================================================
// CYPH TRANSFER
// =========================================================

model CyphTransfer {
  id String @id @default(uuid())

  transactionId String @unique

  fromWalletId String
  toWalletId   String

  amount Decimal @db.Decimal(36, 18)

  createdAt DateTime @default(now())

  transaction CyphTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  fromWallet CyphWallet @relation("CyphTransferFromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)

  toWallet CyphWallet @relation("CyphTransferToWallet", fields: [toWalletId], references: [id], onDelete: Restrict)

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([createdAt])
}
