generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(uuid())
  address                    String?                     @unique
  email                      String?                     @unique
  passwordHash               String?
  username                   String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  cyphWallet                 CyphWallet?
  marketplaceEntitlements    MarketplaceEntitlement[]
  marketplaceIdempotencyKeys MarketplaceIdempotencyKey[]
  marketplaceSales           MarketplaceOrder[]          @relation("SellerOrders")
  marketplaceOrders          MarketplaceOrder[]          @relation("BuyerOrders")
  marketplacePayments        MarketplacePayment[]
  marketplacePaymentEvents   MarketplacePaymentEvent[]
  parcelsOwned               Parcel[]
  parcelListings             ParcelListing[]
  newParcelOwnerships        ParcelOwnershipHistory[]    @relation("NewParcelOwner")
  previousParcelOwnerships   ParcelOwnershipHistory[]    @relation("PreviousParcelOwner")
  parcelReservations         ParcelReservation[]
  projects                   Project[]
}

model Project {
  id          String          @id
  ownerId     String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  template    ProjectTemplate @default(editor)
  scene       Json?
  slug        String?         @unique
  publishedAt DateTime?
  parcelId    String?         @unique
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parcel      Parcel?         @relation(fields: [parcelId], references: [id])
  assets      ProjectAsset[]

  @@index([ownerId])
  @@index([publishedAt])
}

model ProjectAsset {
  id           String   @id @default(uuid())
  projectId    String
  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, storageKey])
  @@index([projectId])
}

model Parcel {
  id                      String                   @id @default(uuid())
  estateId                String                   @unique
  x                       Int
  y                       Int
  status                  ParcelStatus             @default(available)
  ownerId                 String?
  price                   Decimal?                 @db.Decimal(12, 2)
  name                    String?
  description             String?
  blockchainAddress       String?
  tokenId                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  type                    ParcelType               @default(STANDARD)
  marketplaceEntitlements MarketplaceEntitlement[]
  marketplaceOrders       MarketplaceOrder[]
  owner                   User?                    @relation(fields: [ownerId], references: [id])
  listings                ParcelListing[]
  ownershipHistory        ParcelOwnershipHistory[]
  reservations            ParcelReservation[]
  project                 Project?

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([x, y])
}

model ParcelOwnershipHistory {
  id                 String            @id @default(uuid())
  parcelId           String
  previousOwnerId    String?
  newOwnerId         String?
  transferredAt      DateTime          @default(now())
  source             String?
  marketplaceOrderId String?
  createdAt          DateTime          @default(now())
  marketplaceOrder   MarketplaceOrder? @relation(fields: [marketplaceOrderId], references: [id])
  newOwner           User?             @relation("NewParcelOwner", fields: [newOwnerId], references: [id])
  parcel             Parcel            @relation(fields: [parcelId], references: [id])
  previousOwner      User?             @relation("PreviousParcelOwner", fields: [previousOwnerId], references: [id])

  @@index([parcelId, transferredAt])
  @@index([previousOwnerId])
  @@index([newOwnerId])
  @@index([marketplaceOrderId])
}

model ParcelListing {
  id                String              @id @default(uuid())
  parcelId          String
  sellerId          String
  price             Decimal             @db.Decimal(36, 18)
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  currency          MarketplaceCurrency @default(USD)
  marketplaceOrders MarketplaceOrder[]
  parcel            Parcel              @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  seller            User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([sellerId])
  @@index([active])
}

model ParcelReservation {
  id        String   @id @default(uuid())
  parcelId  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  parcel    Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([userId])
  @@index([expiresAt])
}

model MarketplaceOrder {
  id               String                      @id @default(uuid())
  userId           String
  productId        String
  listingId        String?
  quantity         Int                         @default(1)
  amount           Decimal                     @db.Decimal(36, 18)
  status           MarketplaceOrderStatus      @default(PENDING)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  currency         MarketplaceCurrency         @default(USD)
  sellerId         String
  cyphPayment      MarketplaceCYPHPayment?
  entitlements     MarketplaceEntitlement[]
  idempotencyKeys  MarketplaceIdempotencyKey[]
  listing          ParcelListing?              @relation(fields: [listingId], references: [id])
  product          Parcel                      @relation(fields: [productId], references: [id])
  seller           User                        @relation("SellerOrders", fields: [sellerId], references: [id])
  user             User                        @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)
  payments         MarketplacePayment[]
  paymentEvents    MarketplacePaymentEvent[]
  ownershipHistory ParcelOwnershipHistory[]

  @@index([userId])
  @@index([productId])
  @@index([listingId])
  @@index([sellerId])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
}

model MarketplacePayment {
  id                    String                        @id @default(uuid())
  orderId               String
  userId                String
  externalTransactionId String?                       @unique
  amount                Decimal                       @db.Decimal(36, 18)
  status                MarketplacePaymentStatus      @default(PENDING)
  environment           MarketplacePaymentEnvironment @default(LOCAL)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  confirmedAt           DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  method                MarketplacePaymentMethod
  network               String?
  metadata              Json?
  currency              MarketplaceCurrency
  order                 MarketplaceOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                MarketplacePaymentEvent[]     @relation("PaymentEvents")

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([environment])
}

model MarketplaceCYPHPayment {
  id            String           @id @default(uuid())
  orderId       String           @unique
  walletId      String
  transactionId String           @unique
  amount        Decimal          @db.Decimal(36, 18)
  createdAt     DateTime         @default(now())
  order         MarketplaceOrder @relation(fields: [orderId], references: [id])
  transaction   CyphTransaction  @relation(fields: [transactionId], references: [id])
  wallet        CyphWallet       @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([createdAt])
}

model MarketplacePaymentEvent {
  id                    String                        @id @default(uuid())
  externalEventId       String                        @unique
  externalTransactionId String?
  orderId               String
  userId                String
  status                MarketplacePaymentStatus
  environment           MarketplacePaymentEnvironment @default(LOCAL)
  processed             Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  processedAt           DateTime?
  payment               MarketplacePayment?           @relation("PaymentEvents", fields: [externalTransactionId], references: [externalTransactionId])
  order                 MarketplaceOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([externalTransactionId])
  @@index([orderId])
  @@index([userId])
  @@index([processed])
  @@index([createdAt])
}

model MarketplaceEntitlement {
  id        String                       @id @default(uuid())
  userId    String
  productId String
  orderId   String
  quantity  Int                          @default(1)
  status    MarketplaceEntitlementStatus @default(GRANTED)
  grantedAt DateTime                     @default(now())
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  order     MarketplaceOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Parcel                       @relation(fields: [productId], references: [id])
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
}

model MarketplaceIdempotencyKey {
  id             String            @id @default(uuid())
  userId         String
  operation      String
  key            String
  orderId        String?
  responseStatus Int?
  responseJson   Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  order          MarketplaceOrder? @relation(fields: [orderId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model CyphSupply {
  id                String   @id @default("global")
  totalIssued       Decimal  @default(0) @db.Decimal(36, 18)
  totalBurned       Decimal  @default(0) @db.Decimal(36, 18)
  circulatingSupply Decimal  @default(0) @db.Decimal(36, 18)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CyphWallet {
  id                  String                   @id @default(uuid())
  userId              String                   @unique
  balance             Decimal                  @default(0) @db.Decimal(36, 18)
  blockchainAddress   String?                  @unique
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  burns               CyphBurn[]
  issuances           CyphIssuance[]
  transactionsFrom    CyphTransaction[]        @relation("CyphTransactionFromWallet")
  transactionsTo      CyphTransaction[]        @relation("CyphTransactionToWallet")
  transfersFrom       CyphTransfer[]           @relation("CyphTransferFromWallet")
  transfersTo         CyphTransfer[]           @relation("CyphTransferToWallet")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplacePayments MarketplaceCYPHPayment[]

  @@index([active])
}

model CyphTransaction {
  id                 String                  @id @default(uuid())
  transactionId      String                  @unique @default(uuid())
  blockchainTxHash   String?                 @unique
  fromWalletId       String?
  toWalletId         String?
  amount             Decimal                 @db.Decimal(36, 18)
  type               CyphTransactionType
  status             CyphTransactionStatus   @default(CONFIRMED)
  referenceType      String?
  referenceId        String?
  idempotencyKey     String?                 @unique
  metadata           Json?
  createdAt          DateTime                @default(now())
  confirmedAt        DateTime?
  burn               CyphBurn?
  issuance           CyphIssuance?
  fromWallet         CyphWallet?             @relation("CyphTransactionFromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWallet           CyphWallet?             @relation("CyphTransactionToWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  transfer           CyphTransfer?
  marketplacePayment MarketplaceCYPHPayment?

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model CyphIssuance {
  id                  String             @id @default(uuid())
  walletId            String
  transactionId       String             @unique
  amount              Decimal            @db.Decimal(36, 18)
  reason              CyphIssuanceReason
  externalReferenceId String?            @unique
  metadata            Json?
  createdAt           DateTime           @default(now())
  transaction         CyphTransaction    @relation(fields: [transactionId], references: [id])
  wallet              CyphWallet         @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([reason])
  @@index([createdAt])
}

model CyphBurn {
  id                  String          @id @default(uuid())
  walletId            String
  transactionId       String          @unique
  amount              Decimal         @db.Decimal(36, 18)
  reason              CyphBurnReason
  externalReferenceId String?         @unique
  metadata            Json?
  createdAt           DateTime        @default(now())
  transaction         CyphTransaction @relation(fields: [transactionId], references: [id])
  wallet              CyphWallet      @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([reason])
  @@index([createdAt])
}

model CyphTransfer {
  id            String          @id @default(uuid())
  transactionId String          @unique
  fromWalletId  String
  toWalletId    String
  amount        Decimal         @db.Decimal(36, 18)
  createdAt     DateTime        @default(now())
  fromWallet    CyphWallet      @relation("CyphTransferFromWallet", fields: [fromWalletId], references: [id])
  toWallet      CyphWallet      @relation("CyphTransferToWallet", fields: [toWalletId], references: [id])
  transaction   CyphTransaction @relation(fields: [transactionId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([createdAt])
}

enum ProjectTemplate {
  editor
  found
}

enum ParcelStatus {
  available
  owned
  reserved
  for_sale
}

enum CyphTransactionType {
  ISSUANCE
  TRANSFER
  BURN
  MARKETPLACE_PAYMENT
  MARKETPLACE_REFUND
  ADMIN_ADJUSTMENT
}

enum CyphTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum CyphIssuanceReason {
  STRIPE_PURCHASE
  PROMOTIONAL
  REWARD
  ADMIN_GRANT
  GENESIS
}

enum CyphBurnReason {
  ADMIN_BURN
  SYSTEM
}

enum ParcelType {
  STANDARD
  CITY_LANDMARK
}

enum MarketplaceOrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  GRANTED
  CANCELLED
  FAILED
}

enum MarketplacePaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum MarketplaceCurrency {
  USD
  ETH
  CYPH
}

enum MarketplacePaymentMethod {
  USD_PROVIDER
  ETH_BLOCKCHAIN
  CYPH_LEDGER
}

enum MarketplacePaymentEnvironment {
  LOCAL
  STAGING
  PRODUCTION
}

enum MarketplaceEntitlementStatus {
  GRANTED
}
