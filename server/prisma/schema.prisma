generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectTemplate {
  editor
  found
}

model User {
  id           String    @id @default(uuid())
  address      String?   @unique
  email        String?   @unique
  passwordHash String?
  username     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Project {
  id          String @id @default(uuid())
  ownerId     String
  name        String
  description String?

  template ProjectTemplate @default(editor)

  scene Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}